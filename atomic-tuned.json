{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#1e3a8a",
          "foreground": "#60a5fa",
          "leading_diamond": "\u256d\u2500\ue0b6",
          "style": "diamond",
          "template": " \uf489 {{ .Name }} ",
          "type": "shell"
        },
        {
          "background": "#dc2626",
          "foreground": "#fef08a",
          "style": "diamond",
          "template": "<parentBackground>\ue0b0</> \uf0e7 ROOT ",
          "type": "root"
        },
        {
          "background": "#8b5cf6",
          "foreground": "#f3f4f6",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "folder_icon": "\uf07c",
            "home_icon": "\uf7db",
            "style": "agnoster_short",
            "max_depth": 3
          },
          "style": "powerline",
          "template": " {{ .Icon }} {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#22d3ee",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#fb923c{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f59e0b{{ end }}",
            "{{ if gt .Ahead 0 }}#10b981{{ end }}",
            "{{ if gt .Behind 0 }}#ef4444{{ end }}"
          ],
          "foreground": "#0c4a6e",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "branch_icon": "\uf418 ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "github_icon": "\uf408 ",
            "gitlab_icon": "\uf296 ",
            "bitbucket_icon": "\uf171 "
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf448 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if .Stashed }} \ueb4b {{ .Stashed.String }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#6366f1",
          "foreground": "#f0f9ff",
          "properties": {
            "style": "dallas",
            "threshold": 500
          },
          "style": "diamond",
          "template": " \uf252 {{ .FormattedMs }} ",
          "trailing_diamond": "\ue0b4",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#16a34a",
          "foreground": "#f0fdf4",
          "leading_diamond": "\ue0b6",
          "properties": {
            "fetch_package_manager": true,
            "npm_icon": "<#dc2626>\ue71e</> ",
            "yarn_icon": "<#2c8ebb>\uf61a</> ",
            "pnpm_icon": "<#f59e0b>\uf02c</> "
          },
          "style": "diamond",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }}{{ end }}{{ .Major }}.{{ .Minor }} ",
          "trailing_diamond": "\ue0b4 ",
          "type": "node"
        },
        {
          "background": "#0ea5e9",
          "foreground": "#fef3c7",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \ue73c {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}\uf10c {{ .Venv }} {{ end }}{{ .Major }}.{{ .Minor }}{{ end }} ",
          "trailing_diamond": "\ue0b4 ",
          "type": "python"
        },
        {
          "background": "#ea580c",
          "foreground": "#fff7ed",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Major }}{{ end }} ",
          "trailing_diamond": "\ue0b4 ",
          "type": "java"
        },
        {
          "background": "#7c3aed",
          "foreground": "#e0e7ff",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \ue77f {{ if .Unsupported }}\uf071{{ else }}{{ .Major }}.{{ .Minor }}{{ end }} ",
          "trailing_diamond": "\ue0b4 ",
          "type": "dotnet"
        },
        {
          "background": "#06b6d4",
          "foreground": "#cffafe",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \ufcd1 {{ if .Error }}{{ .Error }}{{ else }}{{ .Major }}.{{ .Minor }}{{ end }} ",
          "trailing_diamond": "\ue0b4 ",
          "type": "go"
        },
        {
          "background": "#f97316",
          "foreground": "#1c1917",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Major }}.{{ .Minor }}{{ end }} ",
          "trailing_diamond": "\ue0b4 ",
          "type": "rust"
        },
        {
          "background": "#14b8a6",
          "foreground": "#f0fdfa",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \ue798 {{ if .Error }}{{ .Error }}{{ else }}{{ .Major }}.{{ .Minor }}{{ end }} ",
          "trailing_diamond": "\ue0b4 ",
          "type": "dart"
        },
        {
          "background": "#0284c7",
          "foreground": "#fef3c7",
          "leading_diamond": "\ue0b6",
          "properties": {
            "charged_icon": "\uf583 ",
            "charging_icon": "\uf588 ",
            "discharging_icon": "\uf57d "
          },
          "style": "diamond",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }} ",
          "trailing_diamond": "\ue0b4 ",
          "type": "battery"
        },
        {
          "background": "#1e293b",
          "foreground": "#94a3b8",
          "leading_diamond": "\ue0b6",
          "properties": {
            "linux": "\ue712",
            "macos": "\ue711",
            "windows": "\ue70f"
          },
          "style": "diamond",
          "template": " {{ if .WSL }}\ue712 WSL {{ end }}{{ .Icon }} ",
          "trailing_diamond": "\ue0b4 ",
          "type": "os"
        },
        {
          "background": "#334155",
          "foreground": "#cbd5e1",
          "leading_diamond": "\ue0b6",
          "properties": {
            "time_format": "15:04:05"
          },
          "style": "diamond",
          "template": " \uf64f {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b4",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#06b6d4",
          "style": "plain",
          "template": "\u2570\u2500",
          "type": "text"
        },
        {
          "foreground": "#10b981",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef4444{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "{{ if gt .Code 0 }}\uf467{{ else }}\uf42e{{ end }} ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{ .Folder }}{{ if .Root }} \uf0e7{{ end }}",
  "final_space": true,
  "version": 3
}
